# CRM Application Environment Variables
# Apex CRM Production Configuration Template

# Flask Settings
FLASK_APP=backend/app.py
FLASK_ENV=production
FLASK_DEBUG=0
SECRET_KEY=generate_a_secure_random_hex_key_here_for_production

# JWT Settings
JWT_SECRET_KEY=generate_a_strong_random_jwt_secret_key_here
JWT_EXPIRATION_MINUTES=60
JWT_ALGORITHM=HS256

# Server Configuration
PORT=5000
HOST=127.0.0.1
CORS_ORIGINS=*

# MySQL Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_NAME=crm_database
DB_USER=root
DB_PASSWORD=

# SMTP Email Configuration (Optional - leave empty for draft mode)
SMTP_HOST=smtp.mailgun.org
SMTP_PORT=587
SMTP_USER=postmaster@your-domain.com
SMTP_PASSWORD=your_smtp_password_here
SMTP_FROM=support@your-domain.com

